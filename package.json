{
  "name": "@noresponse/mcp",
  "version": "0.2.11",
  "mcpName": "org.noresponse/mcp",
  "author": "NoResponse",
  "type": "module",
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/noresponsehq/mcp/issues"
  },
  "description": "NoResponse signup and gateway risk assessment as an MCP server, for agents",
  "files": [
    "bin",
    "manifest.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://docs.noresponse.org",
  "keywords": [
    "noresponse",
    "mcp",
    "signup",
    "fraud",
    "risk",
    "identity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noresponsehq/mcp.git"
  },
  "bin": {
    "noresponse-mcp": "bin/mcp-server.js"
  },
  "scripts": {
    "build": "bun i && bun src/mcp-server/build.mts && tsc",
    "mcpb:build": "bun i && bun src/mcp-server/build.mts --pack && tsc",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "npm run lint",
    "lint": "eslint --cache --max-warnings=0 src",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/server-legacy": "2.3.1",
    "@stricli/core": "^1.1.2",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "overrides": {
    "hono": ">=4.12.34",
    "fast-uri": ">=4.1.2 <5.0.0",
    "js-yaml": ">=4.3.1 <5.0.0",
    "ip-address": ">=10.3.1 <11.0.0",
    "nanoid@^5.0.0": ">=5.1.16 <6.0.0",
    "brace-expansion@^2.0.0": ">=2.1.4 <3.0.0",
    "body-parser": ">=2.3.0 <3.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.2.0",
    "@cloudflare/workers-types": "^4.20250712.0 || ^5.20261006.1",
    "@eslint/js": "^9.26.0",
    "@types/bun": "^1.2.13",
    "@types/express": "^5.0.1",
    "@types/node": "^18.19.3",
    "bun": "^1.2.12",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.1",
    "wrangler": "^4.59.1"
  },
  "engines": {
    "node": ">=20"
  }
}
